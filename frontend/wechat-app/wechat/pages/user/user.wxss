/* 我的页 */
.mine-page { min-height: 100vh; background: #f3f5f9; padding-bottom: 60rpx; }
.mine-hero { position: relative; overflow: hidden; border-radius: 0 0 32rpx 32rpx; }
.mine-hero-bg {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, #3a86ff 0%, #6a5cff 55%, #9b5cff 100%);
}
.mine-hero-bg::after {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(circle at 85% 15%, rgba(255,255,255,0.25) 0, transparent 40%);
}
.mine-row {
  position: relative; z-index: 1;
  display: flex; flex-direction: row; align-items: center;
  padding: 48rpx 32rpx 24rpx;
}
.mine-avatar { width: 120rpx; height: 120rpx; flex-shrink: 0; }
.mine-avatar-img {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  border: 5rpx solid rgba(255,255,255,0.85);
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.18); background: #fff;
}
.mine-avatar-ph {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  border: 5rpx solid rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.25);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 52rpx; font-weight: 700;
}
.mine-identity { margin-left: 26rpx; flex: 1; }
.mine-name { color: #fff; font-size: 40rpx; font-weight: 700; }
.mine-biz { color: rgba(255,255,255,0.85); font-size: 24rpx; margin-top: 8rpx; }
.mine-edit {
  color: #fff; font-size: 24rpx; font-weight: 600;
  background: rgba(255,255,255,0.22); border: 1rpx solid rgba(255,255,255,0.4);
  padding: 8rpx 24rpx; border-radius: 30rpx; flex-shrink: 0;
}
.mine-tags { position: relative; z-index: 1; padding: 0 32rpx 32rpx; }
.mine-tag {
  display: inline-block; color: #fff; background: rgba(255,255,255,0.22);
  border: 1rpx solid rgba(255,255,255,0.35); font-size: 22rpx;
  padding: 4rpx 18rpx; border-radius: 24rpx; margin-right: 12rpx;
}

/* 菜单 */
.menu {
  background: #fff; border-radius: 24rpx; margin: 24rpx 28rpx 0;
  padding: 12rpx 0; box-shadow: 0 4rpx 20rpx rgba(30,50,90,0.06);
}
.menu-item {
  display: flex; flex-direction: row; align-items: center;
  padding: 28rpx 32rpx;
}
.menu-item + .menu-item { border-top: 1rpx solid #f0f2f7; }
.menu-ico {
  width: 60rpx; height: 60rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; margin-right: 20rpx; flex-shrink: 0;
  background: #eef4ff; color: #3a86ff;
}
.menu-text { font-size: 30rpx; color: #2a2f3a; font-weight: 500; flex: 1; }
.menu-sub {
  font-size: 22rpx; color: #b0b8c8; margin-right: 12rpx;
  max-width: 320rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.menu-arrow { color: #c5ccda; font-size: 40rpx; line-height: 1; }
.mine-footer {
  text-align: center; color: #c5ccda; font-size: 22rpx; margin-top: 40rpx;
}
