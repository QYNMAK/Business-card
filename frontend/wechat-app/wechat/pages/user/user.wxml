<view class="mine-page">
  <!-- 个人信息头 -->
  <view class="mine-hero">
    <view class="mine-hero-bg"></view>
    <view class="mine-row">
      <view class="mine-avatar">
        <block wx:if="{{card.headPic}}">
          <image class="mine-avatar-img" src="{{card.headPic}}" mode="aspectFill"></image>
        </block>
        <block wx:else>
          <view class="mine-avatar-ph"><text>{{card.username ? card.username[0] : '我'}}</text></view>
        </block>
      </view>
      <view class="mine-identity">
        <view class="mine-name">{{card.username || '未设置姓名'}}</view>
        <view class="mine-biz" wx:if="{{card.showBiz}}">{{card.showBiz}}</view>
        <view class="mine-biz" wx:else>点击右侧「编辑」完善名片</view>
      </view>
      <view class="mine-edit" bindtap="toEdit">编辑</view>
    </view>
    <!-- 平台标签 -->
    <view class="mine-tags" wx:if="{{card.platform}}">
      <text class="mine-tag">{{card.platform}}</text>
      <text class="mine-tag" wx:if="{{card.showBiz}}">{{card.showBiz}}</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu">
    <view class="menu-item" bindtap="toQr">
      <view class="menu-ico menu-ico-qr">▦</view>
      <view class="menu-text">我的名片二维码</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="changeApiHost">
      <view class="menu-ico menu-ico-api">⇄</view>
      <view class="menu-text">接口地址</view>
      <view class="menu-sub">{{apiHost}}</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" wx:if="{{hasCard}}" bindtap="clearCard">
      <view class="menu-ico menu-ico-clear">⌫</view>
      <view class="menu-text">清空名片</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="loginOut">
      <view class="menu-ico menu-ico-out">⎋</view>
      <view class="menu-text">退出登录</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="mine-footer">商家名片 · 本地开发版</view>
</view>
