/* 编辑名片页 */
.edit-page { min-height: 100vh; background: #f3f5f9; }
.edit-scroll { padding: 24rpx 28rpx; }
.ed-section {
  background: #fff; border-radius: 20rpx;
  padding: 8rpx 28rpx 16rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(30,50,90,0.05);
}
.ed-label {
  font-size: 24rpx; color: #98a1b3; font-weight: 600;
  letter-spacing: 2rpx; padding: 24rpx 0 8rpx;
  display: flex; align-items: center;
}
.ed-label::before {
  content: ""; width: 6rpx; height: 24rpx;
  background: linear-gradient(#3a86ff, #9b5cff);
  border-radius: 4rpx; margin-right: 14rpx;
}
.ed-item {
  display: flex; flex-direction: row; align-items: center;
  padding: 20rpx 0; border-top: 1rpx solid #f2f4f9;
}
.ed-section .ed-item:first-of-type { border-top: none; }
.ed-item-td { flex-direction: column; align-items: stretch; }
.ed-name { width: 180rpx; font-size: 28rpx; color: #4a5266; flex-shrink: 0; }
.ed-item-td .ed-name { width: auto; margin-bottom: 14rpx; }
.ed-input {
  flex: 1; font-size: 28rpx; color: #2a2f3a; padding: 6rpx 0;
}
.ed-item-td .ed-input { width: 100%; }
.ed-textarea {
  width: 100%; height: 140rpx; font-size: 28rpx; color: #2a2f3a;
  line-height: 1.5; box-sizing: border-box;
}
.ed-placeholder { color: #b0b8c8; }

/* 头像 */
.avatar-row { display: flex; flex-direction: row; align-items: center; padding: 12rpx 0; }
.avatar-pick { position: relative; width: 140rpx; height: 140rpx; }
.avatar-preview {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  border: 4rpx solid #eef1f7; background: #f7f9fc;
}
.avatar-change {
  position: absolute; bottom: 0; right: 0;
  background: rgba(58,134,255,0.9); color: #fff;
  font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 16rpx;
}
.avatar-add {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: #eef4ff; color: #3a86ff; font-size: 56rpx;
  display: flex; align-items: center; justify-content: center;
}
.avatar-remove { margin-left: 24rpx; color: #ff5c5c; font-size: 26rpx; }

/* 二维码 */
.qr-pick { width: 200rpx; height: 200rpx; }
.qr-preview { width: 200rpx; height: 200rpx; background: #fff; border: 2rpx solid #eef1f7; border-radius: 12rpx; padding: 12rpx; box-sizing: border-box; }
.qr-add {
  width: 200rpx; height: 200rpx; border: 2rpx dashed #b8c6e6; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  color: #3a86ff; font-size: 26rpx; background: #f8faff;
}

/* 平台 picker */
.ed-picker { flex: 1; }
.ed-picker-val { font-size: 28rpx; color: #2a2f3a; }

/* 保存 */
.ed-save {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: linear-gradient(135deg, #3a86ff, #9b5cff);
  color: #fff; font-size: 30rpx; font-weight: 600;
  border-radius: 44rpx; border: none;
  box-shadow: 0 10rpx 24rpx rgba(58,134,255,0.3);
  margin-top: 8rpx;
}
.ed-save[disabled] { opacity: 0.6; }
.ed-save::after { border: none; }
.ed-space { height: 40rpx; }
