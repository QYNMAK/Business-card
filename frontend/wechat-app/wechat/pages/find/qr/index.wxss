/* 名片主展示页 —— 高级视觉 */
.card-page {
  min-height: 100vh;
  background: #f3f5f9;
  padding-bottom: 60rpx;
}

/* ===== 顶部渐变头图 ===== */
.hero {
  position: relative;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #3a86ff 0%, #6a5cff 55%, #9b5cff 100%);
  opacity: 0.95;
}
.hero-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 80% 10%, rgba(255,255,255,0.25) 0, transparent 40%),
    radial-gradient(circle at 15% 90%, rgba(255,255,255,0.15) 0, transparent 35%);
}
.hero-content {
  position: relative;
  z-index: 1;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.hero-avatar {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
}
.avatar-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.85);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.18);
  background: #fff;
}
.avatar-placeholder {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.18);
}
.avatar-initial {
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
}
.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  background: rgba(255,255,255,0.92);
  color: #3a86ff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  border: 2rpx solid #fff;
}
.hero-name {
  margin-left: 30rpx;
  flex: 1;
}
.hero-name-text {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}
.hero-platform {
  margin-top: 12rpx;
}
.platform-tag {
  display: inline-block;
  color: #fff;
  background: rgba(255,255,255,0.22);
  border: 1rpx solid rgba(255,255,255,0.4);
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 24rpx;
}
.hero-biz {
  margin-top: 14rpx;
  color: rgba(255,255,255,0.95);
  font-size: 30rpx;
  font-weight: 500;
}
.hero-desc {
  margin-top: 10rpx;
  color: rgba(255,255,255,0.82);
  font-size: 24rpx;
  line-height: 1.5;
  max-width: 480rpx;
}
.hero-greeting {
  margin-top: 8rpx;
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
  font-style: italic;
}

/* ===== 卡片通用 ===== */
.card-panel, .qr-panel {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx 28rpx 0;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(30,50,90,0.06);
}
.sec-title {
  font-size: 24rpx;
  color: #98a1b3;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.sec-title::before {
  content: "";
  width: 6rpx;
  height: 26rpx;
  background: linear-gradient(#3a86ff, #9b5cff);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

/* 联系方式 */
.contact-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.contact-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f7f9fc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.contact-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  background: #eef4ff;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.contact-body { flex: 1; }
.contact-label {
  font-size: 22rpx;
  color: #98a1b3;
}
.contact-value {
  font-size: 30rpx;
  color: #2a2f3a;
  font-weight: 600;
  margin-top: 4rpx;
  word-break: break-all;
}
.contact-action {
  font-size: 24rpx;
  color: #3a86ff;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border: 2rpx solid #3a86ff;
  border-radius: 28rpx;
  flex-shrink: 0;
}
.contact-empty {
  color: #b0b8c8;
  font-size: 26rpx;
  text-align: center;
  padding: 20rpx 0;
}
.address-line {
  font-size: 28rpx;
  color: #4a5266;
  line-height: 1.6;
}

/* 二维码 */
.qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 6rpx;
}
.qr-img {
  width: 420rpx;
  height: 420rpx;
  background: #fff;
  border: 2rpx solid #eef1f7;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
}
.qr-empty {
  width: 420rpx;
  height: 420rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b8c8;
  font-size: 26rpx;
}
.qr-tip {
  margin-top: 20rpx;
  color: #98a1b3;
  font-size: 24rpx;
}
.qr-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 28rpx;
}
.qr-btn {
  flex: 1;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #eef4ff;
  color: #3a86ff;
  border: none;
}
.qr-btn-share {
  background: linear-gradient(135deg, #3a86ff, #9b5cff);
  color: #fff;
}
.qr-btn::after { border: none; }

/* 底部操作 */
.footer-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin: 32rpx 28rpx 0;
}
.footer-btn {
  flex: 1;
  text-align: center;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.footer-btn-primary {
  background: linear-gradient(135deg, #3a86ff, #9b5cff);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(58,134,255,0.3);
}
.footer-btn-ghost {
  flex: 0 0 200rpx;
  background: #fff;
  color: #ff5c5c;
  border: 2rpx solid #ffd6d6;
}
.err-toast {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 40rpx;
  background: rgba(255,90,90,0.95);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  z-index: 99;
}
