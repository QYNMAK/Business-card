.relationed-num{
  height: 60rpx;
  padding-top: 20rpx;
  padding-left: 20rpx;
  font-size: 25rpx;
  color: #999999;
  background: #EFEFF4;
}
.relation-container{
  display: flex;
  background: #EFEFF4;
  padding-top: 20rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
  justify-content:flex-start ;
  flex-flow: wrap;
}
.relation-customer-item-img{
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
}
.relation-customer-item{
  position: relative;
  text-align: center;
  line-height: 80rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}
.relation-customer-item-name{
  font-size: 25rpx;
  line-height: 25rpx;
  text-align: center;
  position: absolute;
  top: 98rpx;
  width: 100%;
}
.relation-customer-item-cancel{
  position: absolute;
  top: -8rpx;
  right: 18rpx;
  width: 10rpx;
  height: 10rpx;
}
.relation-add-icon{
  padding-top: 10rpx;
  margin-right: 10rpx;
}
.userinfo-avatar-for-name{
  color: white;
  background: #3196ff;
  margin-bottom: 20px;
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
}