.qr-container{
  /* background:#EFEFF4; */
  height: 900rpx;
  padding-top: 25rpx;
}
.icard{
  padding-left: 20rpx;
  padding-top: 30rpx;
  padding-bottom: 30rpx;
  margin-top: 25px;
  background:#3196ff;
  color: white;
  width: 92%;
  margin-left: auto;
  margin-right: auto;
  border-radius: 4%;
  position: relative;
}
.icard-avatar{
  border-radius: 50%;
  height: 150rpx;
  width: 150rpx;
}
.icard-avatar,.icard-name{
  display: inline-block;
}
.icard-name{
  position: absolute;
  top: 50rpx;
  margin-left: 30rpx;
}
.icard-avatar-box{
  margin-bottom: 30rpx;
}


.func-btn-box{
  position: absolute;
  bottom: 60rpx;
  left: 10%;
  width: 100%;
}
.add-customer{
  width: 80% !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  color: white;
  background:#3196ff;
}