/**index.wxss**/
page {
  height: 100%;
}

.content {
  padding-bottom: 20rpx;
  box-sizing: border-box;
  height: 100%;
  position: fixed
}

.location {
  width: 100%;
}

.location_top {
  height: 76rpx;
  line-height: 76rpx;
  background: #f4f4f4;
  color: #606660;
  font-size: 28rpx;
  padding: 0 20rpx;
}

.location_bottom {
  height: 140rpx;
  line-height: 140rpx;
  color: #d91f16;
  font-size: 28rpx;
  border-top: 2rpx #ebebeb solid;
  border-bottom: 2rpx #ebebeb solid;
  padding: 0 20rpx;
  align-items: center;
  display: -webkit-flex;
}

.address_top {
  height: 56rpx;
  line-height: 56rpx;
  background: #EBEBEB;
  color: #999999;
  font-size: 28rpx;
  padding: 0 20rpx;
}

.location_img {
  width: 48rpx;
  height: 48rpx;
  position: absolute;
  right: 20rpx;
  top: 125rpx;
}

.add_city {
  width: 228rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border: 2rpx solid #ebebeb;
  color: #000000;
  margin-right: 20rpx;
}

.add_citying {
  width: 228rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border: 2rpx solid #09bb07;
  color: #09bb07;
  margin-right: 20rpx;
}

.orientation {
  white-space: normal;
  display: inline-block;
  width: 45rpx;
  height: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: rgb(88, 87, 87);
  text-align: center;
}

.orientation_region {
  padding: 5px 0px;
  width: 45rpx;
  font-size: 20rpx;
  position: fixed;
  top: 50%;
  right: 6rpx;
  transform: translate(0, -50%);
  background: rgb(199, 198, 198);
  border-radius: 10px
}

.orientation_city {
  height: 40rpx;
  line-height: 40rpx;
  color: #000;
  text-align: center;
}

.active {
  color: #2cc1d1;
}

.search {
  width: 100%;
  background-color: #EFEFF4;
}

.search-fixed {
  position: fixed;
  z-index: 1000;
}

.search-option {
  border: none;
  width: 100%;
  z-index: 999;
  height: 56rpx;
  line-height: 56rpx;
  background: #fff;
  color: #999999;
  font-size: 25rpx;
  z-index: 9999;
  display: flex;
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;

}

.search-option view:nth-of-type(1) {
  flex-grow: 1;
  color:#3196ff;
}

.search-option view:nth-of-type(2) {
  flex-grow: 1;

}

.search-option view:nth-of-type(3) {
  flex-grow: 1;

}

.search-option-item {
  text-align: center;
  font-weight: 500;
}

.fixed-title {
  color: #2cc1d1
}

.userinfo-avatar {
  width: 150rpx;
  height: 150rpx;
  margin: 20rpx;
  border-radius: 50%;
}
.user-name-box{
  padding-top: 30rpx;
}
.user_name {
  height: 90rpx;
  width: 80%;
  padding-top: 35rpx;
}

.user {
  display: flex;
  position: relative;
}
.user-tel,.user-addr{
  color: #999999;
  font-size: 25rpx;
}

.search-bar {
  position: relative;
  padding: 8px 10px;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  box-sizing: border-box;
  background-color: #EFEFF4;
}

.weui-icon-search {
  margin-right: 4px;
  font-size: inherit;
}

.weui-icon-search_in-box {
  position: absolute;
  left: 10px;
  top: 7px;
}

.search-bar-text {
  display: inline-block;
  font-size: 16px;
}

.search-bar-form {
  position: relative;
  -webkit-box-flex: 1;
  -webkit-flex: auto;
  flex: auto;
  border-radius: 5px;
  background: #FFFFFF;
  border: 1rpx solid #E6E6EA;
}

.search-bar-box {
  position: relative;
  padding-left: 30px;
  padding-right: 30px;
  width: 100%;
  box-sizing: border-box;
  z-index: 1;
}

.search-bar-input {
  height: 28px;
  line-height: 28px;
  font-size: 14px;
}

.search-bar-abel {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  border-radius: 3px;
  text-align: center;
  color: #9B9B9B;
  background: #FFFFFF;
  line-height: 28px;
}

.search-bar-cancel-btn {
  margin-left: 10px;
  line-height: 28px;
  color: #09BB07;
  white-space: nowrap;
}

.user-relation{
  position: absolute;
  right: 75rpx;
  bottom: 70rpx;
  width: 110rpx !important;
  height: 50rpx !important;
  font-size: 25rpx !important;
  font-weight: 500 !important;
  color: white  !important;
  background: #3196ff !important;
  border:none !important;
}
.userinfo-avatar {
  width: 130rpx;
  height: 130rpx;
  margin: 20rpx;
  margin-right: 30rpx;
  border-radius: 50%;
}
.userinfo-avatar-for-name{
  text-align: center;
  vertical-align: middle;
  background: #3196ff;
  line-height: 130rpx;
  color: white;
}
.user-name-box {
  height: 90rpx;
  width: 80%;
  padding-top: 35rpx;
}
.user {
  display: flex;
  padding-left: 30rpx;
}