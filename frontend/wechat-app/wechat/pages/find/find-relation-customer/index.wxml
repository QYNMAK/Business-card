<view>

	<!-- 左侧列表内容部分 -->
	<scroll-view class="content" enable-back-to-top scroll-into-view="{{toView}}" scroll-y="true" scroll-with-animation="true">
		<!-- 搜索区域 -->
		<view class="search {{searchActive ? 'search-fixed':''}}" id="inToView0">
			<!-- 搜索 -->
			<view id="search">
				<view>
					<view class="search-bar">
						<view class="search-bar-form">
							<!-- 最初始时的搜索框 -->
							<view class="search-bar-box">
								<icon class="weui-icon-search_in-box" type="search" size="14"></icon>
								<input type="text" class="search-bar-input" placeholder="搜索" />
							</view>
							<!-- 可编辑时的搜索框 -->
							<label class="search-bar-abel" hidden="{{inputShowed}}" bindtap="showInput">
								<icon class="weui-icon-search" type="search" size="14"></icon>
								<view class="search-bar-text">搜索联系人</view>
							</label>
						</view>
						<!-- 取消搜索 -->
						<view class="search-bar-cancel-btn" hidden="{{!inputShowed}}" bindtap="hideInput">取消</view>
					</view>
				</view>
			</view>
			<!-- 筛选 -->
			<view class="search-option" style="flex-direction:row;">
				<view class="search-option-item">姓氏</view>
				<view class="search-option-item">年龄</view>
				<view class="search-option-item">筛选</view>
			</view>
		</view>
		<!-- 列表 -->
		<view>
			<view class="user" wx:for="{{listMain}}" wx:for-item="user" wx:key="brandId" style="flex-direction:row;">
				<block wx:if="{{user.previewImg}}">
					<image class="userinfo-avatar" src="{{user.previewImg}}" mode="cover"></image>
				</block>
				<block wx:else>
					<view class="userinfo-avatar userinfo-avatar-for-name">{{user.showName}}</view>
				</block>
			
				<view class="user-name-box" data-id='{{user.id}}'>
					<view class="user-name">{{user.name}}</view>
					<view class="user-tel">{{user.phone || ''}}</view>
					<view class="user-addr">{{user.province || ''}}{{user.city|| ''}}{{user.county|| ''}}{{user.address|| ''}}</view>
					 <button bindtap="relationUser" data-name='{{user.name}}' data-index="{{index}}" data-id='{{user.id}}' size="mini" class="user-relation" type="default" plain="true">{{user.relation == 1 ?"已关联":"未关联"}}</button>
				</view>
			</view>
		</view>
	</scroll-view>


</view>