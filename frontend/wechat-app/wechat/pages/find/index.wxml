<view class="find-page">
  <!-- 扫码大入口 -->
  <view class="scan-hero" bindtap="qrScan">
    <view class="scan-hero-bg"></view>
    <view class="scan-ico">⌖</view>
    <view class="scan-title">扫一扫</view>
    <view class="scan-sub">扫描他人名片二维码，查看名片</view>
  </view>

  <!-- 快捷 -->
  <view class="quick-row">
    <view class="quick-item" bindtap="toMyCard">
      <view class="quick-ico">▣</view>
      <view class="quick-name">我的名片</view>
      <view class="quick-sub">查看 / 编辑</view>
    </view>
  </view>

  <!-- 最近浏览 -->
  <view class="recent-sec" wx:if="{{recent.length}}">
    <view class="recent-title">最近查看</view>
    <view class="recent-list">
      <view class="recent-item" wx:for="{{recent}}" wx:key="id" wx:for-item="card" data-card="{{card}}" bindtap="viewCard">
        <view class="r-avatar">
          <block wx:if="{{card.headPic}}"><image class="r-avatar-img" src="{{card.headPic}}" mode="aspectFill"></image></block>
          <block wx:else><view class="r-avatar-ph">{{card.username ? card.username[0] : '?'}}</view></block>
        </view>
        <view class="r-info">
          <view class="r-name">{{card.username || '未知'}}</view>
          <view class="r-biz" wx:if="{{card.biz}}">{{card.biz}}</view>
        </view>
        <view class="r-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="find-empty" wx:if="{{!recent.length}}">
    <view>还没有名片，点上方「扫一扫」开始添加</view>
  </view>
</view>
