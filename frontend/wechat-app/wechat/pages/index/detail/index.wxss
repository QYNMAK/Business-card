/* 名片详情页（他人名片） */
.detail-page { min-height: 100vh; background: #f3f5f9; padding-bottom: 60rpx; }
.d-hero { position: relative; overflow: hidden; border-radius: 0 0 32rpx 32rpx; }
.d-hero-bg {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, #3a86ff 0%, #6a5cff 55%, #9b5cff 100%);
}
.d-row {
  position: relative; z-index: 1;
  display: flex; flex-direction: row; align-items: center;
  padding: 48rpx 32rpx 24rpx;
}
.d-avatar { width: 130rpx; height: 130rpx; flex-shrink: 0; }
.d-avatar-img {
  width: 130rpx; height: 130rpx; border-radius: 50%;
  border: 5rpx solid rgba(255,255,255,0.85);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.18); background: #fff;
}
.d-avatar-ph {
  width: 130rpx; height: 130rpx; border-radius: 50%;
  border: 5rpx solid rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.25);
  color: #fff; font-size: 56rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.d-info { margin-left: 28rpx; flex: 1; }
.d-name { color: #fff; font-size: 42rpx; font-weight: 700; }
.d-biz { color: rgba(255,255,255,0.95); font-size: 28rpx; font-weight: 500; margin-top: 8rpx; }
.d-desc { color: rgba(255,255,255,0.8); font-size: 24rpx; margin-top: 8rpx; line-height: 1.5; }
.d-tags { position: relative; z-index: 1; padding: 0 32rpx 32rpx; }
.d-tag {
  display: inline-block; color: #fff; background: rgba(255,255,255,0.22);
  border: 1rpx solid rgba(255,255,255,0.35); font-size: 22rpx;
  padding: 4rpx 18rpx; border-radius: 24rpx; margin-right: 12rpx;
}
.d-greet {
  text-align: center; color: #6a5cff; font-size: 26rpx;
  font-style: italic; padding: 24rpx 0 4rpx;
}
.d-panel {
  background: #fff; border-radius: 20rpx; margin: 20rpx 28rpx 0;
  padding: 24rpx 28rpx; box-shadow: 0 4rpx 16rpx rgba(30,50,90,0.05);
}
.d-label {
  font-size: 24rpx; color: #98a1b3; font-weight: 600; letter-spacing: 2rpx;
  margin-bottom: 18rpx; display: flex; align-items: center;
}
.d-label::before {
  content: ""; width: 6rpx; height: 24rpx;
  background: linear-gradient(#3a86ff, #9b5cff);
  border-radius: 4rpx; margin-right: 14rpx;
}
.d-contact {
  display: flex; flex-direction: row; align-items: center;
  padding: 18rpx 0; border-top: 1rpx solid #f2f4f9;
}
.d-contact:first-of-type { border-top: none; }
.d-c-ico {
  width: 130rpx; font-size: 24rpx; color: #4a5266; flex-shrink: 0;
}
.d-c-val { flex: 1; font-size: 28rpx; color: #2a2f3a; font-weight: 600; word-break: break-all; }
.d-c-btn {
  font-size: 24rpx; color: #3a86ff; font-weight: 600;
  padding: 8rpx 20rpx; border: 2rpx solid #3a86ff; border-radius: 28rpx;
  flex-shrink: 0;
}
.d-contact-empty { color: #b0b8c8; font-size: 26rpx; }
.d-addr { font-size: 28rpx; color: #4a5266; line-height: 1.6; }
.d-qr-wrap { display: flex; justify-content: center; }
.d-qr-img { width: 240rpx; height: 240rpx; background: #fff; }
.d-actions { display: flex; padding: 32rpx 28rpx 0; }
.d-share {
  flex: 1; height: 84rpx; line-height: 84rpx;
  background: linear-gradient(135deg, #3a86ff, #9b5cff);
  color: #fff; font-size: 28rpx; font-weight: 600;
  border-radius: 42rpx; border: none;
  box-shadow: 0 10rpx 24rpx rgba(58,134,255,0.3);
}
.d-share::after { border: none; }
.d-empty { text-align: center; color: #98a1b3; padding-top: 200rpx; font-size: 28rpx; }
