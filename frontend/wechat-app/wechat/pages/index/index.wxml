<view class="contacts-page">
  <!-- 搜索条 -->
  <view class="ct-search">
    <view class="ct-search-bar">
      <text class="ct-search-ico">🔍</text>
      <input class="ct-search-input" bindconfirm="searchSubmit" bindinput="filterLive" value="{{keywords}}" placeholder="搜索姓名 / 业务 / 电话 / 平台" focus="{{inputShowed}}" confirm-type="search" />
      <view class="ct-scan" bindtap="scan">扫一扫</view>
    </view>
  </view>

  <!-- 名片夹 -->
  <view class="ct-body">
    <block wx:if="{{listMain.length}}">
      <view class="ct-count">共 {{listMain.length}} 张名片</view>
      <view class="ct-card" wx:for="{{listMain}}" wx:key="id" wx:for-item="card" data-card="{{card}}" bindtap="userDetail">
        <view class="ct-avatar">
          <block wx:if="{{card.headPic}}"><image class="ct-avatar-img" src="{{card.headPic}}" mode="aspectFill"></image></block>
          <block wx:else><view class="ct-avatar-ph">{{card.username ? card.username[0] : '?'}}</view></block>
        </view>
        <view class="ct-info">
          <view class="ct-name">
            <text>{{card.username || '未知'}}</text>
            <text class="ct-tag" wx:if="{{card.platform}}">{{card.platform}}</text>
          </view>
          <view class="ct-biz" wx:if="{{card.biz}}">{{card.biz}}</view>
          <view class="ct-sub" wx:if="{{card.phone || card.wechatId}}">
            <text wx:if="{{card.phone}}">📞 {{card.phone}}</text>
            <text wx:if="{{card.wechatId}}" class="ct-wechat">💬 {{card.wechatId}}</text>
          </view>
        </view>
        <view class="ct-arrow">›</view>
      </view>
    </block>

    <view class="ct-empty" wx:else>
      <view class="ct-empty-ico">📇</view>
      <view class="ct-empty-title">名片夹还没有名片</view>
      <view class="ct-empty-sub">在上方点「扫一扫」查看他人名片，会自动存进这里</view>
    </view>
  </view>
</view>
